PORT=4000
FRONTEND_URL=http://localhost:3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=isasrl
# Prefer secret files instead of plain values
DB_USER_FILE=./secrets/db_user.txt
DB_PASSWORD_FILE=./secrets/db_password.txt
# DB_USER=isasrl_user
# DB_PASSWORD=isasrl_password

# Back-office auth key (required for /api/admin/contacts)
ADMIN_DASHBOARD_KEY_FILE=./secrets/admin_dashboard_key.txt
# ADMIN_DASHBOARD_KEY=ChangeThis_Admin_Dashboard_Key_123!

# Anti-spam rate limiting
CONTACT_RATE_LIMIT_MAX=6
CONTACT_RATE_LIMIT_WINDOW_MS=600000
