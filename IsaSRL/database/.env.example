# Docker images
POSTGRES_IMAGE=postgres:16
PGADMIN_IMAGE=dpage/pgadmin4:8

# Docker client timeouts (useful on slow image pulls/builds)
COMPOSE_HTTP_TIMEOUT=240
DOCKER_CLIENT_TIMEOUT=240

# Ports exposed on host
POSTGRES_PORT=5432
BACKEND_PORT=4000
FRONTEND_PORT=3000
PGADMIN_PORT=5050

# Database credentials
POSTGRES_DB=isasrl

# Docker secrets files (relative to database/)
POSTGRES_USER_SECRET_FILE=./secrets/postgres_user.txt
POSTGRES_PASSWORD_SECRET_FILE=./secrets/postgres_password.txt
PGADMIN_PASSWORD_SECRET_FILE=./secrets/pgadmin_password.txt
ADMIN_DASHBOARD_KEY_SECRET_FILE=./secrets/admin_dashboard_key.txt

# pgAdmin login
PGADMIN_DEFAULT_EMAIL=admin@isasrl.it
PGADMIN_MASTER_PASSWORD_REQUIRED=True

# Contact anti-spam settings
CONTACT_RATE_LIMIT_MAX=6
CONTACT_RATE_LIMIT_WINDOW_MS=600000

# App URLs
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Frontend navbar style: luxe | corporate
NEXT_PUBLIC_NAV_STYLE=luxe

# Home visual mode: soft | intense
NEXT_PUBLIC_HOME_VISUAL_MODE=soft

# Home color profile: fusion | warm | techno
NEXT_PUBLIC_HOME_COLOR_PROFILE=fusion

# Home art direction: industrial | glass-neon
NEXT_PUBLIC_HOME_ART_DIRECTION=glass-neon
