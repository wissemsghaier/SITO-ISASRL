# Docker images
POSTGRES_IMAGE=postgres:16
PGADMIN_IMAGE=dpage/pgadmin4:8

# Ports exposed on host
POSTGRES_PORT=5432
BACKEND_PORT=4000
FRONTEND_PORT=3000
PGADMIN_PORT=5050

# Database credentials
POSTGRES_DB=isasrl
POSTGRES_USER=isasrl_user
POSTGRES_PASSWORD=ChangeThis_DB_Password_123!

# pgAdmin login
PGADMIN_DEFAULT_EMAIL=admin@isasrl.it
PGADMIN_DEFAULT_PASSWORD=ChangeThis_pgAdmin_Password_123!
PGADMIN_MASTER_PASSWORD_REQUIRED=True

# App URLs
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
